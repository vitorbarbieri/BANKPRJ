      *>---------------------------------------------------------------
       PROCEDURE DIVISION.
       0000-PRINCIPAL.
           IF  EIBCALEN = ZEROS
               MOVE MSJ-SIN-ACC        TO WS-MENSAJE
               PERFORM 9999-VOLVER-MENU-PRINCIPAL
           ELSE
               MOVE DFHCOMMAREA        TO WS-COMMAREA

               IF  WS-PRIMERA-VEZ
                   PERFORM 1900-INICIALIZAR-MENU
                   PERFORM 1900-MOSTRAR-PANTALLA-MENU
               ELSE
                   IF  WS-HAY-PROGRAMA
                       PERFORM 0100-EVALUAR-PROGRAMA
                   ELSE
                       PERFORM 1900-INICIALIZAR-MENU
                       PERFORM 1000-RECIBIR-MENU
                   END-IF
               END-IF
           END-IF
           .

      *>---------------------------------------------------------------
       0100-EVALUAR-PROGRAMA.
           EVALUATE TRUE
               WHEN WS-PROG-ALTA
                    PERFORM 2900-INICIALIZAR-ALTA
                    PERFORM 2000-RECIBIR-ALTA
               WHEN WS-PROG-CONSULTA
                    PERFORM 3900-INICIALIZAR-CONSULTA
                    PERFORM 3000-RECIBIR-CONSULTA
               WHEN WS-PROG-MODIFICACION
                    PERFORM 4900-INICIALIZAR-MODIF
                    PERFORM 4000-RECIBIR-MODIF
               WHEN WS-PROG-BAJA
                    PERFORM 5900-INICIALIZAR-BAJA
                    PERFORM 5000-RECIBIR-BAJA
      *        WHEN WS-PROG-REACTIVACION
           END-EVALUATE
           .

      *>---------------------------------------------------------------
      *>   SECCION 1000 - MENU CLIENTE
      *>---------------------------------------------------------------
       1000-RECIBIR-MENU.
           MOVE DFHCOMMAREA            TO WS-COMMAREA

           EXEC CICS
                RECEIVE
                MAP('BKCLI00')
                MAPSET('BKMCLI')
                RESP(WS-RESP)
                RESP2(WS-RESP2)
           END-EXEC

           PERFORM 1100-EVALUAR-TECLA
           .

      *>---------------------------------------------------------------
       1100-EVALUAR-TECLA.
           MOVE EIBAID                 TO WS-EIBAID
           MOVE OPC0I                  TO WS-OPCION

           EVALUATE TRUE
               WHEN WS-PF3
               OR   WS-SALIR
                    PERFORM 9999-VOLVER-MENU-PRINCIPAL
               WHEN WS-PF12
                    PERFORM 1900-INICIALIZAR-MENU
                    PERFORM 1900-MOSTRAR-PANTALLA-MENU
               WHEN WS-ENTER
                    PERFORM 1200-PROCESAR-OPCION
               WHEN OTHER
                    PERFORM 9000-SEND-CONTROL
           END-EVALUATE
           .

      *>---------------------------------------------------------------
       1200-PROCESAR-OPCION.
           IF  OPC0L = ZEROS
           OR  OPC0I = SPACE
               MOVE MSJ-ING-OPC        TO MSJ0O
               MOVE DFHRED             TO OPC0C
               MOVE DFHRED             TO MSJ0C
               PERFORM 1900-MOSTRAR-PANTALLA-MENU
           END-IF

           EVALUATE TRUE
               WHEN WS-ALTA
                    PERFORM 2900-INICIALIZAR-ALTA
                    PERFORM 2900-MOSTRAR-PANTALLA-ALTA
               WHEN WS-CONSULTA
                    PERFORM 3900-INICIALIZAR-CONSULTA
                    PERFORM 3900-MOSTRAR-PANTALLA-CONSULTA
               WHEN WS-MODIFICACION
                    PERFORM 4900-INICIALIZAR-MODIF
                    PERFORM 4900-MOSTRAR-PANTALLA-MODIF
               WHEN WS-BAJA
                    PERFORM 5900-INICIALIZAR-BAJA
                    PERFORM 5900-MOSTRAR-PANTALLA-BAJA
               WHEN WS-REACTIVACION
                    PERFORM 1900-MOSTRAR-PANTALLA-MENU
               WHEN OTHER
                    MOVE MSJ-OPC-NO-VAL TO MSJ0O
                    MOVE DFHRED        TO OPC0C
                    MOVE DFHRED        TO MSJ0C
                    PERFORM 1900-MOSTRAR-PANTALLA-MENU
           END-EVALUATE
           .

      *>---------------------------------------------------------------
       1900-INICIALIZAR-MENU.
           INITIALIZE                  WS-CAMPOS-TRABAJO
           MOVE LOW-VALUES             TO BKCLI00I
           .

      *>---------------------------------------------------------------
       1900-MOSTRAR-PANTALLA-MENU.
           MOVE 2                      TO WS-COM-OPCION

           PERFORM 9000-OBTENER-FECHA-HORA
           MOVE WS-FECHA               TO FCH0O
           MOVE WS-HORA                TO HRA0O

           EXEC CICS
                SEND
                MAP('BKCLI00')
                MAPSET('BKMCLI')
                ERASE
                FREEKB
           END-EXEC

           PERFORM 9000-RETURN-TRANSID
           .

      *>---------------------------------------------------------------
      *>   SECCION 2000 - ALTA CLIENTE
      *>---------------------------------------------------------------
       2000-RECIBIR-ALTA.
           MOVE DFHCOMMAREA            TO WS-COMMAREA

           EXEC CICS
                RECEIVE
                MAP('BKCLI01')
                MAPSET('BKMCLI')
                RESP(WS-RESP)
                RESP2(WS-RESP2)
           END-EXEC

           PERFORM 2100-EVALUAR-TECLA
           .

      *>---------------------------------------------------------------
       2100-EVALUAR-TECLA.
           MOVE EIBAID                 TO WS-EIBAID

           EVALUATE TRUE
               WHEN WS-PF3
                    PERFORM 1900-INICIALIZAR-MENU
                    PERFORM 1900-MOSTRAR-PANTALLA-MENU
               WHEN WS-PF12
                    PERFORM 2900-INICIALIZAR-ALTA
                    PERFORM 2900-MOSTRAR-PANTALLA-ALTA
               WHEN WS-ENTER
                    PERFORM 2200-PROCESAR-CAMPOS
               WHEN OTHER
                    PERFORM 9000-SEND-CONTROL
           END-EVALUATE
           .

      *>---------------------------------------------------------------
       2200-PROCESAR-CAMPOS.
           PERFORM 2210-CAPTURAR-DATOS-PANTALLA

           PERFORM 2220-VALIDAR-DATOS

           IF  WS-SIN-ERROR
               PERFORM 2230-MOVER-DATOS-CLIENTE
           ELSE
               MOVE DFHRED             TO MSJ1C
               PERFORM 2900-MOSTRAR-PANTALLA-ALTA
           END-IF
           .

      *>---------------------------------------------------------------
       2210-CAPTURAR-DATOS-PANTALLA.
           IF  DOC1L > 0
           AND DOC1I NOT = SPACES
           AND DOC1I NOT = LOW-VALUES
               MOVE DOC1I              TO WS-COM-DOC
           ELSE
               MOVE SPACES             TO WS-COM-DOC
           END-IF

           IF  NMB1L > 0
           AND NMB1I NOT = SPACES
           AND NMB1I NOT = LOW-VALUES
               MOVE NMB1I              TO WS-COM-NOMBRE
           ELSE
               MOVE SPACES             TO WS-COM-NOMBRE
           END-IF

           IF  MAIL1L > 0
           AND MAIL1I NOT = SPACES
           AND MAIL1I NOT = LOW-VALUES
               MOVE MAIL1I             TO WS-COM-EMAIL
           ELSE
               MOVE SPACES             TO WS-COM-EMAIL
           END-IF

           IF  TEL1L > 0
           AND TEL1I NOT = SPACES
           AND TEL1I NOT = LOW-VALUES
               MOVE TEL1I              TO WS-COM-TEL
           ELSE
               MOVE SPACES             TO WS-COM-TEL
           END-IF
           .

      *>---------------------------------------------------------------
       2220-VALIDAR-DATOS.
           PERFORM 9000-VALIDAR-DOCUMENTO
           IF  WS-CON-ERROR
               MOVE WS-MENSAJE         TO MSJ1O
               MOVE DFHRED             TO DOC1C
               MOVE -1                 TO DOC1L
           END-IF

           IF  WS-SIN-ERROR
               PERFORM 9000-VALIDAR-NOMBRE
               IF  WS-CON-ERROR
                   MOVE WS-MENSAJE     TO MSJ1O
                   MOVE DFHRED         TO NMB1C
                   MOVE -1             TO NMB1L
               END-IF
           END-IF

           IF  WS-SIN-ERROR
               PERFORM 9000-VALIDAR-EMAIL
               IF  WS-CON-ERROR
                   MOVE WS-MENSAJE    TO MSJ1O
                   MOVE DFHRED        TO MAIL1C
                   MOVE -1            TO MAIL1L
               END-IF
           END-IF

           IF  WS-SIN-ERROR
               PERFORM 9000-VALIDAR-TELEFONO
               IF  WS-CON-ERROR
                   MOVE WS-MENSAJE     TO MSJ1O
                   MOVE DFHRED         TO TEL1C
                   MOVE -1             TO TEL1L
               END-IF
           END-IF
           .

      *>---------------------------------------------------------------
       2230-MOVER-DATOS-CLIENTE.
           EXEC SQL
                SELECT ULTIMO_ID
                INTO   :HV-ULTIMO-ID
                FROM   BANK.CONTROL_ID
                WHERE  ENTIDAD = 'CLIENTE'
           END-EXEC

           IF  SQLCODE = ZEROS
               ADD 1                   TO HV-ULTIMO-ID

               EXEC SQL
                    UPDATE BANK.CONTROL_ID
                    SET    ULTIMO_ID = :HV-ULTIMO-ID
                    WHERE  ENTIDAD = 'CLIENTE'
               END-EXEC

               IF  SQLCODE NOT = ZEROS
                   MOVE SQLCODE        TO WS-SQLCODE
                   STRING MSJ-ERR-UPD-CTRL-ID DELIMITED BY SIZE
                          WS-SQLCODE          DELIMITED BY SIZE
                                       INTO MSJ1O
               END-IF
           ELSE
               IF  SQLCODE = 100
                   MOVE 1              TO HV-ULTIMO-ID

                   EXEC SQL
                        INSERT INTO BANK.CONTROL_ID
                              (ENTIDAD,
                               ULTIMO_ID)
                        VALUES('CLIENTE',
                               :HV-ULTIMO-ID)
                   END-EXEC

                   IF  SQLCODE NOT = ZEROS
                       MOVE SQLCODE        TO WS-SQLCODE
                       STRING MSJ-ERR-INS-CTRL-ID DELIMITED BY SIZE
                              WS-SQLCODE          DELIMITED BY SIZE
                                           INTO MSJ1O
                   END-IF
               ELSE
                   MOVE SQLCODE        TO WS-SQLCODE
                   STRING MSJ-ERR-SEL-CTRL-ID DELIMITED BY SIZE
                          WS-SQLCODE          DELIMITED BY SIZE
                                       INTO MSJ1O
               END-IF
           END-IF

           IF  SQLCODE = ZEROS
           OR  SQLCODE = 100
               PERFORM 2231-SALVAR-CLIENTE
           ELSE
               EXEC SQL ROLLBACK END-EXEC

               MOVE DFHRED             TO MSJ1C
               MOVE -1                 TO DOC1L
               MOVE 1                  TO WS-ID-STATUS-ERROR
               PERFORM 2900-MOSTRAR-PANTALLA-ALTA
           END-IF
           .

      *>---------------------------------------------------------------
       2231-SALVAR-CLIENTE.
           MOVE HV-ULTIMO-ID           TO HV-ID-CLIENTE

           MOVE WS-COM-DOC             TO HV-DOCID

           MOVE LENGTH OF WS-COM-NOMBRE TO HV-NOMBRE-LEN
           MOVE WS-COM-NOMBRE          TO HV-NOMBRE-TEXT

           IF  WS-COM-EMAIL NOT = SPACES
           AND WS-COM-EMAIL NOT = LOW-VALUES
               MOVE LENGTH OF WS-COM-EMAIL TO HV-EMAIL-LEN
               MOVE WS-COM-EMAIL       TO HV-EMAIL-TEXT
           ELSE
               MOVE -1                 TO WS-IND-EMAIL
           END-IF

           IF  WS-COM-TEL NOT = SPACES
           AND WS-COM-TEL NOT = LOW-VALUES
               MOVE WS-COM-TEL         TO HV-TELEFONO
           ELSE
               MOVE -1                 TO WS-IND-TEL
           END-IF

           PERFORM 9000-OBTENER-FECHA-HORA
           MOVE WS-FECHA               TO HV-FECHA-ALTA

           MOVE 'A'                    TO HV-ESTADO

           EXEC SQL
                INSERT INTO BANK.CLIENTE
                      (ID_CLIENTE,
                       DOCID,
                       NOMBRE,
                       EMAIL,
                       TELEFONO,
                       FECHA_ALTA,
                       ESTADO)
                VALUES(:HV-ID-CLIENTE,
                       :HV-DOCID,
                       :HV-NOMBRE,
                       :HV-EMAIL      :WS-IND-EMAIL,
                       :HV-TELEFONO   :WS-IND-TEL,
                       :HV-FECHA-ALTA,
                       :HV-ESTADO)
           END-EXEC

           IF  SQLCODE = ZEROS
               EXEC SQL COMMIT END-EXEC

               PERFORM 2900-INICIALIZAR-ALTA
               MOVE HV-ID-CLIENTE      TO WS-COM-ID
               STRING MSJ-CLI-ALTA-OK DELIMITED BY SIZE
                      WS-COM-ID       DELIMITED BY SIZE
                                       INTO MSJ1O
               MOVE -1                 TO DOC1L
               PERFORM 2900-MOSTRAR-PANTALLA-ALTA
           ELSE
               EXEC SQL ROLLBACK END-EXEC

               MOVE MSJ-ERR-INS-CLI    TO MSJ1O
               MOVE DFHRED             TO MSJ1C
               MOVE -1                 TO DOC1L
               MOVE 1                  TO WS-ID-STATUS-ERROR
               PERFORM 2900-MOSTRAR-PANTALLA-ALTA
           END-IF
           .

      *>---------------------------------------------------------------
       2900-INICIALIZAR-ALTA.
           INITIALIZE                  WS-CAMPOS-TRABAJO
           MOVE LOW-VALUES             TO BKCLI01I
           .

      *>---------------------------------------------------------------
       2900-MOSTRAR-PANTALLA-ALTA.
           MOVE 2                      TO WS-COM-OPCION
           MOVE 1                      TO WS-COM-PROGRAMA

           MOVE WS-COM-DOC             TO DOC1O
           MOVE WS-COM-NOMBRE          TO NMB1O
           MOVE WS-COM-EMAIL           TO MAIL1O
           MOVE WS-COM-TEL             TO TEL1O

           PERFORM 9000-OBTENER-FECHA-HORA
           MOVE WS-FECHA               TO FCH1O
           MOVE WS-HORA                TO HRA1O

           IF  WS-SIN-ERROR
               EXEC CICS
                    SEND
                    MAP('BKCLI01')
                    MAPSET('BKMCLI')
                    ERASE
                    FREEKB
               END-EXEC
           ELSE
               EXEC CICS
                    SEND
                    MAP('BKCLI01')
                    MAPSET('BKMCLI')
                    FREEKB
                    CURSOR
                    ALARM
               END-EXEC
           END-IF

           PERFORM 9000-RETURN-TRANSID
           .

      *>---------------------------------------------------------------
      *>   SECCION 3000 - CONSULTA CLIENTE
      *>---------------------------------------------------------------
       3000-RECIBIR-CONSULTA.
           MOVE DFHCOMMAREA            TO WS-COMMAREA

           EXEC CICS
                RECEIVE
                MAP('BKCLI02')
                MAPSET('BKMCLI')
                RESP(WS-RESP)
                RESP2(WS-RESP2)
           END-EXEC

           PERFORM 3100-EVALUAR-TECLA
           .

      *>---------------------------------------------------------------
       3100-EVALUAR-TECLA.
           MOVE EIBAID                 TO WS-EIBAID

           EVALUATE TRUE
               WHEN WS-PF3
                    PERFORM 1900-INICIALIZAR-MENU
                    PERFORM 1900-MOSTRAR-PANTALLA-MENU
               WHEN WS-PF12
                    PERFORM 3900-INICIALIZAR-CONSULTA
                    PERFORM 3900-MOSTRAR-PANTALLA-CONSULTA
               WHEN WS-ENTER
                    PERFORM 3200-PROCESAR-CAMPOS
               WHEN OTHER
                    PERFORM 9000-SEND-CONTROL
           END-EVALUATE
           .

      *>---------------------------------------------------------------
       3200-PROCESAR-CAMPOS.
           PERFORM 3210-CAPTURAR-DATOS-PANTALLA

           PERFORM 3220-VALIDAR-DATOS

           IF  WS-SIN-ERROR
               PERFORM 3230-BUSCAR-CLIENTE
           ELSE
               MOVE DFHRED             TO MSJ2C
               PERFORM 3900-MOSTRAR-PANTALLA-CONSULTA
           END-IF
           .

      *>---------------------------------------------------------------
       3210-CAPTURAR-DATOS-PANTALLA.
           IF  IDBUS2L > 0
           AND IDBUS2I NOT = SPACES
           AND IDBUS2I NOT = LOW-VALUES
               MOVE IDBUS2I            TO WS-COM-ID-BUSQ
           ELSE
               MOVE SPACES             TO WS-COM-ID-BUSQ
           END-IF

           IF  DOCBUS2L > 0
           AND DOCBUS2I NOT = SPACES
           AND DOCBUS2I NOT = LOW-VALUES
               MOVE DOCBUS2I           TO WS-COM-DOC-BUSQ
           ELSE
               MOVE SPACES             TO WS-COM-DOC-BUSQ
           END-IF
           .

      *>---------------------------------------------------------------
       3220-VALIDAR-DATOS.
           IF  (WS-COM-ID-BUSQ = SPACES
           OR   WS-COM-ID-BUSQ = LOW-VALUES)
           AND (WS-COM-DOC-BUSQ = SPACES
           OR   WS-COM-DOC-BUSQ = LOW-VALUES)
               MOVE MSJ-ING-DOC-O-ID-CLI TO MSJ2O
               MOVE DFHRED             TO IDBUS2C
               MOVE DFHRED             TO DOCBUS2C
               MOVE -1                 TO DOCBUS2L
               MOVE 1                  TO WS-ID-STATUS-ERROR
           END-IF

           IF  WS-SIN-ERROR
           AND WS-COM-ID-BUSQ NOT = SPACES
           AND WS-COM-ID-BUSQ NOT = LOW-VALUES
           AND WS-COM-DOC-BUSQ NOT = SPACES
           AND WS-COM-DOC-BUSQ NOT = LOW-VALUES
               MOVE MSJ-ING-UN-CRIT-BUSQ TO MSJ2O
               MOVE DFHRED             TO IDBUS2C
               MOVE DFHRED             TO DOCBUS2C
               MOVE -1                 TO DOCBUS2L
               MOVE 1                  TO WS-ID-STATUS-ERROR
           END-IF

           IF  WS-SIN-ERROR
           AND WS-COM-ID-BUSQ NOT = SPACES
           AND WS-COM-ID-BUSQ NOT = LOW-VALUES
           AND WS-COM-ID-BUSQ IS NOT NUMERIC
               MOVE MSJ-ID-CLI-NO-NUM  TO MSJ2O
               MOVE DFHRED             TO IDBUS2C
               MOVE -1                 TO IDBUS2L
               MOVE 1                  TO WS-ID-STATUS-ERROR
           END-IF

           IF  WS-SIN-ERROR
           AND WS-COM-DOC-BUSQ NOT = SPACES
           AND WS-COM-DOC-BUSQ NOT = LOW-VALUES
               MOVE WS-COM-DOC-BUSQ    TO WS-COM-DOC
               PERFORM 9000-VALIDAR-DOCUMENTO
               IF  WS-CON-ERROR
                   MOVE WS-MENSAJE     TO MSJ2O
                   MOVE DFHRED         TO DOCBUS2C
                   MOVE -1             TO DOCBUS2L
               END-IF
               MOVE SPACES             TO WS-COM-DOC
           END-IF
           .

      *>---------------------------------------------------------------
       3230-BUSCAR-CLIENTE.
           INITIALIZE                  WS-CAMPOS-CLIENTE

           IF  WS-COM-ID-BUSQ NOT = SPACES
           AND WS-COM-ID-BUSQ NOT = LOW-VALUES
               MOVE 1                  TO WS-TP-BUSQUEDA
               MOVE WS-COM-ID-BUSQ     TO HV-ID-CLIENTE

               MOVE SPACES             TO HV-EMAIL-TEXT
               MOVE SPACES             TO HV-TELEFONO
               MOVE ZEROS              TO WS-IND-EMAIL
               MOVE ZEROS              TO WS-IND-TEL

               EXEC SQL
                    SELECT ID_CLIENTE,
                           DOCID,
                           NOMBRE,
                           EMAIL,
                           TELEFONO,
                           FECHA_ALTA,
                           ESTADO
                    INTO   :HV-ID-CLIENTE,
                           :HV-DOCID,
                           :HV-NOMBRE,
                           :HV-EMAIL :WS-IND-EMAIL,
                           :HV-TELEFONO :WS-IND-TEL,
                           :HV-FECHA-ALTA,
                           :HV-ESTADO
                    FROM   BANK.CLIENTE
                    WHERE  ID_CLIENTE = :HV-ID-CLIENTE
               END-EXEC
           ELSE
               MOVE 2                  TO WS-TP-BUSQUEDA

               EXEC SQL
                    SELECT ID_CLIENTE,
                           DOCID,
                           NOMBRE,
                           EMAIL,
                           TELEFONO,
                           FECHA_ALTA,
                           ESTADO
                    INTO   :HV-ID-CLIENTE,
                           :HV-DOCID,
                           :HV-NOMBRE,
                           :HV-EMAIL :WS-IND-EMAIL,
                           :HV-TELEFONO :WS-IND-TEL,
                           :HV-FECHA-ALTA,
                           :HV-ESTADO
                    FROM   BANK.CLIENTE
                    WHERE  DOCID = :WS-COM-DOC-BUSQ
               END-EXEC
           END-IF

           IF  SQLCODE = ZEROS
               INITIALIZE              WS-CAMPOS-BUSQUEADA
               MOVE MSJ-CLI-LOC        TO MSJ2O

               MOVE HV-ID-CLIENTE      TO WS-COM-ID
               MOVE HV-DOCID           TO WS-COM-DOC
               MOVE HV-NOMBRE-TEXT     TO WS-COM-NOMBRE

               IF  WS-IND-EMAIL NOT = -1
                   MOVE HV-EMAIL-TEXT  TO WS-COM-EMAIL
               END-IF

               IF  WS-IND-TEL NOT = -1
                   MOVE HV-TELEFONO    TO WS-COM-TEL
               END-IF

               MOVE HV-FECHA-ALTA      TO WS-COM-FALTA
               MOVE HV-ESTADO          TO WS-COM-ESTADO
               MOVE '0'                TO WS-COM-CUENTAS
           ELSE
               IF  SQLCODE = 100
                   MOVE MSJ-CLI-NO-ENCONT TO MSJ2O
                   MOVE DFHRED         TO MSJ2C
                   MOVE 1              TO WS-ID-STATUS-ERROR

                   IF  WS-BUSQUEDA-ID
                       MOVE -1         TO IDBUS2L
                       MOVE DFHRED     TO IDBUS2C
                   ELSE
                       MOVE -1         TO DOCBUS2L
                       MOVE DFHRED     TO DOCBUS2C
                   END-IF
               ELSE
                   MOVE SQLCODE        TO WS-SQLCODE
                   STRING MSJ-ERR-SEL-CLI DELIMITED BY SIZE
                          WS-SQLCODE      DELIMITED BY SIZE
                                       INTO MSJ2O
                   MOVE DFHRED         TO MSJ2C
                   MOVE 1              TO WS-ID-STATUS-ERROR

                   IF  WS-BUSQUEDA-ID
                       MOVE -1         TO IDBUS2L
                       MOVE DFHRED     TO IDBUS2C
                   ELSE
                       MOVE -1         TO DOCBUS2L
                       MOVE DFHRED     TO DOCBUS2C
                   END-IF
               END-IF
           END-IF

           PERFORM 3900-MOSTRAR-PANTALLA-CONSULTA
           .

      *>---------------------------------------------------------------
       3900-INICIALIZAR-CONSULTA.
           INITIALIZE                  WS-CAMPOS-TRABAJO
           MOVE LOW-VALUES             TO BKCLI02I
           .

      *>---------------------------------------------------------------
       3900-MOSTRAR-PANTALLA-CONSULTA.
           MOVE 2                      TO WS-COM-OPCION
           MOVE 2                      TO WS-COM-PROGRAMA

           MOVE WS-COM-ID              TO ID2O
           MOVE WS-COM-DOC             TO DOC2O
           MOVE WS-COM-NOMBRE          TO NMB2O
           MOVE WS-COM-EMAIL           TO MAIL2O
           MOVE WS-COM-TEL             TO TEL2O
           MOVE WS-COM-FALTA           TO FALTA2O
           MOVE WS-COM-ESTADO          TO EST2O
           MOVE WS-COM-CUENTAS         TO CTAS2O
           MOVE WS-COM-ID-BUSQ         TO IDBUS2O
           MOVE WS-COM-DOC-BUSQ        TO DOCBUS2O

           PERFORM 9000-OBTENER-FECHA-HORA
           MOVE WS-FECHA               TO FCH2O
           MOVE WS-HORA                TO HRA2O

           IF  WS-SIN-ERROR
               EXEC CICS
                    SEND
                    MAP('BKCLI02')
                    MAPSET('BKMCLI')
                    ERASE
                    FREEKB
               END-EXEC
           ELSE
               EXEC CICS
                    SEND
                    MAP('BKCLI02')
                    MAPSET('BKMCLI')
                    FREEKB
                    CURSOR
                    ALARM
               END-EXEC
           END-IF

           PERFORM 9000-RETURN-TRANSID
           .

      *>---------------------------------------------------------------
      *>   SECCION 4000 - MODIFICACION CLIENTE
      *>---------------------------------------------------------------
       4000-RECIBIR-MODIF.
           MOVE DFHCOMMAREA            TO WS-COMMAREA

           EXEC CICS
                RECEIVE
                MAP('BKCLI03')
                MAPSET('BKMCLI')
                RESP(WS-RESP)
                RESP2(WS-RESP2)
           END-EXEC

           PERFORM 4100-EVALUAR-TECLA
           .

      *>---------------------------------------------------------------
       4100-EVALUAR-TECLA.
           MOVE EIBAID                 TO WS-EIBAID

           EVALUATE TRUE
               WHEN WS-PF3
                    PERFORM 1900-INICIALIZAR-MENU
                    PERFORM 1900-MOSTRAR-PANTALLA-MENU
               WHEN WS-PF12
                    PERFORM 4900-INICIALIZAR-MODIF
                    PERFORM 4900-MOSTRAR-PANTALLA-MODIF
               WHEN WS-PF5
                    PERFORM 4200-PROCESAR-CAMPOS
               WHEN WS-ENTER
                    PERFORM 4300-PROCESAR-CAMPOS
               WHEN OTHER
                    PERFORM 9000-SEND-CONTROL
           END-EVALUATE
           .

      *>---------------------------------------------------------------
       4200-PROCESAR-CAMPOS.
           IF  WS-COM-ID = SPACES
               MOVE MSJ-LOC-CLI-ANTES  TO MSJ3O
               MOVE DFHRED             TO DOCBUS3C
               MOVE -1                 TO DOCBUS3L
               MOVE 1                  TO WS-ID-STATUS-ERROR
               MOVE DFHRED             TO MSJ3C

               PERFORM 4900-MOSTRAR-PANTALLA-MODIF
           END-IF
           MOVE DOCBUS3I               TO WS-COM-DOC

           PERFORM 4210-VALIDAR-DIFF

           IF  WS-SIN-ERROR
               PERFORM 4220-CAPTURAR-DATOS-PANTALLA

               PERFORM 4230-VALIDAR-DATOS
           END-IF

           IF  WS-SIN-ERROR
               PERFORM 4240-ACTUALIZAR-CLIENTE
           ELSE
               MOVE DFHRED             TO MSJ3C
               PERFORM 4900-MOSTRAR-PANTALLA-MODIF
           END-IF
           .

      *>---------------------------------------------------------------
       4210-VALIDAR-DIFF.
           IF  NMB3I = WS-COM-NOMBRE
           AND MAIL3I = WS-COM-EMAIL
           AND TEL3I = WS-COM-TEL
               MOVE MSJ-SIN-DATOS-MODIF TO MSJ3O
               MOVE DFHRED             TO NMB3C
               MOVE DFHRED             TO MAIL3C
               MOVE DFHRED             TO TEL3C
               MOVE -1                 TO NMB3L
               MOVE 1                  TO WS-ID-STATUS-ERROR
           END-IF
           .

      *>---------------------------------------------------------------
       4220-CAPTURAR-DATOS-PANTALLA.
           IF  NMB3L > 0
           AND NMB3I NOT = SPACES
           AND NMB3I NOT = LOW-VALUES
               MOVE NMB3I              TO WS-COM-NOMBRE
           ELSE
               MOVE SPACES             TO WS-COM-NOMBRE
           END-IF

           IF  MAIL3L > 0
           AND MAIL3I NOT = SPACES
           AND MAIL3I NOT = LOW-VALUES
               MOVE MAIL3I             TO WS-COM-EMAIL
           ELSE
               MOVE SPACES             TO WS-COM-EMAIL
           END-IF

           IF  TEL3L > 0
           AND TEL3I NOT = SPACES
           AND TEL3I NOT = LOW-VALUES
               MOVE TEL3I              TO WS-COM-TEL
           ELSE
               MOVE SPACES             TO WS-COM-TEL
           END-IF
           .

      *>---------------------------------------------------------------
       4230-VALIDAR-DATOS.
           PERFORM 9000-VALIDAR-NOMBRE
           IF  WS-CON-ERROR
               MOVE WS-MENSAJE         TO MSJ3O
               MOVE DFHRED             TO NMB3C
               MOVE -1                 TO NMB3L
           END-IF

           IF  WS-SIN-ERROR
               PERFORM 9000-VALIDAR-EMAIL
               IF  WS-CON-ERROR
                   MOVE WS-MENSAJE     TO MSJ3O
                   MOVE DFHRED         TO MAIL3C
                   MOVE -1             TO MAIL3L
               END-IF
           END-IF

           IF  WS-SIN-ERROR
               PERFORM 9000-VALIDAR-TELEFONO
               IF  WS-CON-ERROR
                   MOVE WS-MENSAJE     TO MSJ3O
                   MOVE DFHRED         TO TEL3C
                   MOVE -1             TO TEL3L
               END-IF
           END-IF
           .

      *>---------------------------------------------------------------
       4240-ACTUALIZAR-CLIENTE.
           MOVE LENGTH OF WS-COM-NOMBRE TO HV-NOMBRE-LEN
           MOVE WS-COM-NOMBRE          TO HV-NOMBRE-TEXT

           IF  WS-COM-EMAIL NOT = SPACES
               MOVE LENGTH OF WS-COM-EMAIL TO HV-EMAIL-LEN
               MOVE WS-COM-EMAIL       TO HV-EMAIL-TEXT
           ELSE
               MOVE -1                 TO WS-IND-EMAIL
           END-IF

           IF  WS-COM-TEL NOT = SPACES
               MOVE WS-COM-TEL         TO HV-TELEFONO
           ELSE
               MOVE -1                 TO WS-IND-TEL
           END-IF

           EXEC SQL
                UPDATE BANK.CLIENTE
                SET    NOMBRE = :HV-NOMBRE,
                       EMAIL = :HV-EMAIL,
                       TELEFONO = :HV-TELEFONO
                WHERE  DOCID = :WS-COM-DOC
           END-EXEC

           IF  SQLCODE = ZEROS
               EXEC SQL COMMIT END-EXEC

               PERFORM 4900-INICIALIZAR-MODIF
               MOVE MSJ-CLI-ACT        TO MSJ3O
           ELSE
               EXEC SQL ROLLBACK END-EXEC

               MOVE SQLCODE            TO WS-SQLCODE
               STRING MSJ-ERR-UPD-CLI DELIMITED BY SIZE
                      WS-SQLCODE      DELIMITED BY SIZE
                                       INTO MSJ3O
               MOVE DFHRED             TO MSJ3C
               MOVE -1                 TO DOCBUS3L
               MOVE 1                  TO WS-ID-STATUS-ERROR
           END-IF

           PERFORM 4900-MOSTRAR-PANTALLA-MODIF
           .

      *>---------------------------------------------------------------
       4300-PROCESAR-CAMPOS.
           PERFORM 4310-VALIDAR-CLI-YA-CONSULTADO

           PERFORM 4320-CAPTURAR-DATOS-PANTALLA

           MOVE DOCBUS3I               TO WS-COM-DOC
           PERFORM 9000-VALIDAR-DOCUMENTO
           IF  WS-CON-ERROR
               MOVE WS-MENSAJE         TO MSJ3O
               MOVE DFHRED             TO DOCBUS3C
               MOVE -1                 TO DOCBUS3L
           END-IF
           MOVE SPACES                 TO WS-COM-DOC

           IF  WS-SIN-ERROR
               PERFORM 4330-BUSCAR-CLIENTE
           ELSE
               MOVE DFHRED             TO MSJ3C
               PERFORM 4900-MOSTRAR-PANTALLA-MODIF
           END-IF
           .

      *>---------------------------------------------------------------
       4310-VALIDAR-CLI-YA-CONSULTADO.
           IF  WS-COM-ID NOT = SPACES
               PERFORM 9000-SEND-CONTROL
           END-IF
           .

      *>---------------------------------------------------------------
       4320-CAPTURAR-DATOS-PANTALLA.
           IF  DOCBUS3L > 0
           AND DOCBUS3I NOT = SPACES
           AND DOCBUS3I NOT = LOW-VALUES
               MOVE DOCBUS3I           TO WS-COM-DOC-BUSQ
           ELSE
               MOVE SPACES             TO WS-COM-DOC-BUSQ
           END-IF
           .

      *>---------------------------------------------------------------
       4330-BUSCAR-CLIENTE.
           INITIALIZE                  WS-CAMPOS-CLIENTE

           EXEC SQL
                SELECT ID_CLIENTE,
                       DOCID,
                       NOMBRE,
                       EMAIL,
                       TELEFONO,
                       FECHA_ALTA,
                       ESTADO
                INTO   :HV-ID-CLIENTE,
                       :HV-DOCID,
                       :HV-NOMBRE,
                       :HV-EMAIL :WS-IND-EMAIL,
                       :HV-TELEFONO :WS-IND-TEL,
                       :HV-FECHA-ALTA,
                       :HV-ESTADO
                FROM   BANK.CLIENTE
                WHERE  DOCID = :WS-COM-DOC-BUSQ
           END-EXEC

           IF  SQLCODE = ZEROS
               MOVE HV-ESTADO          TO WS-COM-ESTADO

               IF  WS-CLI-BLOQUEADO
                   PERFORM 4331-TRATAR-CLI-BLOQUEADO
               ELSE
                   PERFORM 4332-TRATAR-CLI-ACTIVO
               END-IF
           ELSE
               IF  SQLCODE = 100
                   MOVE MSJ-CLI-NO-ENCONT TO MSJ3O
                   MOVE DFHRED         TO MSJ3C
                   MOVE 1              TO WS-ID-STATUS-ERROR
                   MOVE -1             TO DOCBUS3L
                   MOVE DFHRED         TO DOCBUS3C
               ELSE
                   MOVE SQLCODE        TO WS-SQLCODE
                   STRING MSJ-ERR-SEL-CLI DELIMITED BY SIZE
                          WS-SQLCODE      DELIMITED BY SIZE
                                       INTO MSJ3O
                   MOVE DFHRED         TO MSJ3C
                   MOVE 1              TO WS-ID-STATUS-ERROR
                   MOVE -1             TO DOCBUS3L
                   MOVE DFHRED         TO DOCBUS3C
               END-IF
           END-IF

           PERFORM 4900-MOSTRAR-PANTALLA-MODIF
           .

      *>---------------------------------------------------------------
       4331-TRATAR-CLI-BLOQUEADO.
           INITIALIZE                  WS-CAMPOS-CLIENTE

           MOVE MSJ-CLI-BLOQ           TO MSJ3O
           MOVE DFHRED                 TO MSJ3C
           MOVE 1                      TO WS-ID-STATUS-ERROR
           MOVE -1                     TO DOCBUS3L
           MOVE DFHRED                 TO DOCBUS3C
           .

      *>---------------------------------------------------------------
       4332-TRATAR-CLI-ACTIVO.
           INITIALIZE                  WS-CAMPOS-BUSQUEADA
           MOVE MSJ-CLI-LOC            TO MSJ3O

           MOVE HV-ID-CLIENTE          TO WS-COM-ID
           MOVE HV-DOCID               TO WS-COM-DOC
           MOVE HV-NOMBRE-TEXT         TO WS-COM-NOMBRE

           IF  WS-IND-EMAIL NOT = -1
               MOVE HV-EMAIL-TEXT      TO WS-COM-EMAIL
           END-IF

           IF  WS-IND-TEL NOT = -1
               MOVE HV-TELEFONO        TO WS-COM-TEL
           END-IF

           MOVE HV-FECHA-ALTA          TO WS-COM-FALTA
           .

      *>---------------------------------------------------------------
       4900-INICIALIZAR-MODIF.
           INITIALIZE                  WS-CAMPOS-TRABAJO
           MOVE LOW-VALUES             TO BKCLI03I
           .

      *>---------------------------------------------------------------
       4900-MOSTRAR-PANTALLA-MODIF.
           MOVE 2                      TO WS-COM-OPCION
           MOVE 3                      TO WS-COM-PROGRAMA

           MOVE WS-COM-ID              TO ID3O
           MOVE WS-COM-DOC             TO DOC3O
           MOVE WS-COM-NOMBRE          TO NMB3O
           MOVE WS-COM-EMAIL           TO MAIL3O
           MOVE WS-COM-TEL             TO TEL3O
           MOVE WS-COM-FALTA           TO FALTA3O
           MOVE WS-COM-ESTADO          TO EST3O

           PERFORM 9000-OBTENER-FECHA-HORA
           MOVE WS-FECHA               TO FCH3O
           MOVE WS-HORA                TO HRA3O

           IF  WS-SIN-ERROR
               EXEC CICS
                    SEND
                    MAP('BKCLI03')
                    MAPSET('BKMCLI')
                    ERASE
                    FREEKB
               END-EXEC
           ELSE
               EXEC CICS
                    SEND
                    MAP('BKCLI03')
                    MAPSET('BKMCLI')
                    FREEKB
                    CURSOR
                    ALARM
               END-EXEC
           END-IF

           PERFORM 9000-RETURN-TRANSID
           .

      *>---------------------------------------------------------------
      *>   SECCION 5000 - BAJA CLIENTE
      *>---------------------------------------------------------------
       5000-RECIBIR-BAJA.
           MOVE DFHCOMMAREA            TO WS-COMMAREA

           EXEC CICS
                RECEIVE
                MAP('BKCLI04')
                MAPSET('BKMCLI')
                RESP(WS-RESP)
                RESP2(WS-RESP2)
           END-EXEC

           PERFORM 5100-EVALUAR-TECLA
           .

      *>---------------------------------------------------------------
       5100-EVALUAR-TECLA.
           MOVE EIBAID                 TO WS-EIBAID

           EVALUATE TRUE
               WHEN WS-PF3
                    PERFORM 1900-INICIALIZAR-MENU
                    PERFORM 1900-MOSTRAR-PANTALLA-MENU
               WHEN WS-PF12
                    PERFORM 5900-INICIALIZAR-BAJA
                    PERFORM 5900-MOSTRAR-PANTALLA-BAJA
               WHEN WS-PF5
                    PERFORM 5200-PROCESAR-CAMPOS
               WHEN WS-ENTER
                    PERFORM 5300-PROCESAR-CAMPOS
               WHEN OTHER
                    PERFORM 9000-SEND-CONTROL
           END-EVALUATE
           .

      *>---------------------------------------------------------------
       5200-PROCESAR-CAMPOS.
           IF  WS-COM-ID = SPACES
               MOVE MSJ-LOC-CLI-BLOQ   TO MSJ4O
               MOVE DFHRED             TO DOCBUS4C
               MOVE -1                 TO DOCBUS4L
               MOVE 1                  TO WS-ID-STATUS-ERROR
               MOVE DFHRED             TO MSJ4C

               PERFORM 5900-MOSTRAR-PANTALLA-BAJA
           END-IF

           EVALUATE RESP4I
               WHEN 'S'
                    PERFORM 5210-VALDIAR-SUELDO

                    IF  WS-SIN-ERROR
                        PERFORM 5220-ACTUALIZAR-CLIENTE
                    END-IF
               WHEN 'N'
                    MOVE MSJ-CLI-BLOQ-CAN TO MSJ4O
                    MOVE -1            TO DOCBUS4L
                    MOVE 1             TO WS-ID-STATUS-ERROR
                    MOVE DFHRED        TO MSJ4C
               WHEN OTHER
                    PERFORM 9000-SEND-CONTROL
           END-EVALUATE

           INITIALIZE                  WS-CAMPOS-CLIENTE
           MOVE SPACES                 TO DOCBUS4O
           MOVE SPACES                 TO RESP4O

           PERFORM 5900-MOSTRAR-PANTALLA-BAJA
           .

      *>---------------------------------------------------------------
       5210-VALDIAR-SUELDO.
      *    REALIZAR LA BUESCA DE CUENTAS CON SUELDO

           IF  WS-COM-SUELDO-NUM > ZEROS
               INITIALIZE              WS-CAMPOS-CLIENTE

               MOVE MSJ-CLI-BLOQ-SAL   TO MSJ4O
               MOVE DFHRED             TO DOCBUS4C
               MOVE -1                 TO DOCBUS4L
               MOVE 1                  TO WS-ID-STATUS-ERROR
               MOVE DFHRED             TO MSJ4C
           END-IF
           .

      *>---------------------------------------------------------------
       5220-ACTUALIZAR-CLIENTE.
           PERFORM 9000-OBTENER-FECHA-HORA
           MOVE WS-FECHA               TO HV-FECHA-BAJA

           MOVE 'B'                    TO HV-ESTADO

           EXEC SQL
                UPDATE BANK.CLIENTE
                SET    FECHA_BAJA = :HV-FECHA-BAJA,
                       ESTADO = :HV-ESTADO
                WHERE  DOCID = :WS-COM-DOC
           END-EXEC

           IF  SQLCODE = ZEROS
               EXEC SQL COMMIT END-EXEC

               PERFORM 5900-INICIALIZAR-BAJA
               MOVE MSJ-CLI-BLOQ-OK    TO MSJ4O
           ELSE
               EXEC SQL ROLLBACK END-EXEC

               MOVE SQLCODE            TO WS-SQLCODE
               STRING MSJ-ERR-UPD-CLI DELIMITED BY SIZE
                      WS-SQLCODE      DELIMITED BY SIZE
                                       INTO MSJ4O
               MOVE DFHRED             TO MSJ4C
               MOVE -1                 TO DOCBUS4L
               MOVE 1                  TO WS-ID-STATUS-ERROR
           END-IF
           .

      *>---------------------------------------------------------------
       5300-PROCESAR-CAMPOS.
           PERFORM 5310-CAPTURAR-DATOS-PANTALLA

           MOVE WS-COM-DOC-BUSQ        TO WS-COM-DOC
           PERFORM 9000-VALIDAR-DOCUMENTO
           IF  WS-CON-ERROR
               MOVE WS-MENSAJE         TO MSJ4O
               MOVE DFHRED             TO DOCBUS4C
               MOVE -1                 TO DOCBUS4L
           END-IF
           MOVE SPACES                 TO WS-COM-DOC

           IF  WS-SIN-ERROR
               PERFORM 5320-BUSCAR-CLIENTE
           ELSE
               MOVE DFHRED             TO MSJ4C
               PERFORM 5900-MOSTRAR-PANTALLA-BAJA
           END-IF
           .

      *>---------------------------------------------------------------
       5310-CAPTURAR-DATOS-PANTALLA.
           IF  DOCBUS4L > 0
           AND DOCBUS4I NOT = SPACES
           AND DOCBUS4I NOT = LOW-VALUES
               MOVE DOCBUS4I           TO WS-COM-DOC-BUSQ
           ELSE
               MOVE SPACES             TO WS-COM-DOC-BUSQ
           END-IF
           .

      *>---------------------------------------------------------------
       5320-BUSCAR-CLIENTE.
           EXEC SQL
                SELECT ID_CLIENTE,
                       DOCID,
                       NOMBRE,
                       TELEFONO,
                       ESTADO
                INTO   :HV-ID-CLIENTE,
                       :HV-DOCID,
                       :HV-NOMBRE,
                       :HV-TELEFONO :WS-IND-TEL,
                       :HV-ESTADO
                FROM   BANK.CLIENTE
                WHERE  DOCID = :WS-COM-DOC-BUSQ
           END-EXEC

           IF  SQLCODE = ZEROS
               MOVE HV-ESTADO          TO WS-COM-ESTADO

               IF  WS-CLI-BLOQUEADO
                   PERFORM 5321-TRATAR-CLI-BLOQUEADO
               ELSE
                   PERFORM 5322-TRATAR-CLI-ACTIVO
               END-IF
           ELSE
               IF  SQLCODE = 100
                   MOVE MSJ-CLI-NO-ENCONT TO MSJ4O
                   MOVE DFHRED         TO MSJ4C
                   MOVE 1              TO WS-ID-STATUS-ERROR
                   MOVE -1             TO DOCBUS4L
                   MOVE DFHRED         TO DOCBUS4C
               ELSE
                   MOVE SQLCODE        TO WS-SQLCODE
                   STRING MSJ-ERR-SEL-CLI DELIMITED BY SIZE
                          WS-SQLCODE      DELIMITED BY SIZE
                                       INTO MSJ4O
                   MOVE DFHRED         TO MSJ4C
                   MOVE 1              TO WS-ID-STATUS-ERROR
                   MOVE -1             TO DOCBUS4L
                   MOVE DFHRED         TO DOCBUS4C
               END-IF
           END-IF

           PERFORM 5900-MOSTRAR-PANTALLA-BAJA
           .

      *>---------------------------------------------------------------
       5321-TRATAR-CLI-BLOQUEADO.
           INITIALIZE                  WS-CAMPOS-CLIENTE

           MOVE MSJ-CLI-YA-BLOQ        TO MSJ4O
           MOVE DFHRED                 TO MSJ4C
           MOVE 1                      TO WS-ID-STATUS-ERROR
           MOVE -1                     TO DOCBUS4L
           MOVE DFHRED                 TO DOCBUS4C
           .

      *>---------------------------------------------------------------
       5322-TRATAR-CLI-ACTIVO.
           INITIALIZE                  WS-CAMPOS-BUSQUEADA

           MOVE HV-ID-CLIENTE          TO WS-COM-ID
           MOVE HV-DOCID               TO WS-COM-DOC
           MOVE HV-NOMBRE-TEXT         TO WS-COM-NOMBRE

           IF  WS-IND-TEL NOT = -1
               MOVE HV-TELEFONO        TO WS-COM-TEL
           END-IF

           MOVE HV-ESTADO              TO WS-COM-ESTADO

           MOVE '0'                    TO WS-COM-CUENTAS
           MOVE '0,00'                 TO WS-COM-SUELDO
           .

      *>---------------------------------------------------------------
       5900-INICIALIZAR-BAJA.
           INITIALIZE                  WS-CAMPOS-TRABAJO
           MOVE LOW-VALUES             TO BKCLI04I
           .

      *>---------------------------------------------------------------
       5900-MOSTRAR-PANTALLA-BAJA.
           MOVE 2                      TO WS-COM-OPCION
           MOVE 4                      TO WS-COM-PROGRAMA

           MOVE WS-COM-ID              TO ID4O
           MOVE WS-COM-DOC             TO DOC4O
           MOVE WS-COM-NOMBRE          TO NMB4O
           MOVE WS-COM-TEL             TO TEL4O
           MOVE WS-COM-ESTADO          TO EST4O
           MOVE WS-COM-CUENTAS         TO CTAS4O
           MOVE WS-COM-SUELDO          TO SLD4O

           PERFORM 9000-OBTENER-FECHA-HORA
           MOVE WS-FECHA               TO FCH4O
           MOVE WS-HORA                TO HRA4O

           IF  WS-SIN-ERROR
               EXEC CICS
                    SEND
                    MAP('BKCLI04')
                    MAPSET('BKMCLI')
                    ERASE
                    FREEKB
               END-EXEC
           ELSE
               EXEC CICS
                    SEND
                    MAP('BKCLI04')
                    MAPSET('BKMCLI')
                    FREEKB
                    CURSOR
                    ALARM
               END-EXEC
           END-IF

           PERFORM 9000-RETURN-TRANSID
           .

      *>---------------------------------------------------------------
      *>   SECCION 9000 - PARRAFOS COMUNES DEL PROGRAMA
      *>---------------------------------------------------------------
       9000-OBTENER-FECHA-HORA.
           EXEC CICS
                ASKTIME
                ABSTIME(WS-FECHA-HORA)
           END-EXEC

           EXEC CICS
                FORMATTIME
                ABSTIME(WS-FECHA-HORA)
                DATESEP('-')
                TIMESEP(':')
                YYYYMMDD(WS-FECHA)
                TIME(WS-HORA)
           END-EXEC
           .

      *>---------------------------------------------------------------
       9000-SEND-CONTROL.
           EXEC CICS
                SEND CONTROL
                FREEKB
           END-EXEC

           PERFORM 9000-RETURN-TRANSID
           .

      *>---------------------------------------------------------------
       9000-RETURN-TRANSID.
           EXEC CICS
                RETURN
                TRANSID('BKCL')
                COMMAREA(WS-COMMAREA)
                LENGTH(LENGTH OF WS-COMMAREA)
           END-EXEC
           .

      *>---------------------------------------------------------------
       9000-VALIDAR-DOCUMENTO.
           IF  (WS-COM-DOC = SPACES
           OR   WS-COM-DOC = LOW-VALUES)
           AND NOT WS-PROG-CONSULTA
               MOVE MSJ-DOC-OBL        TO WS-MENSAJE
               MOVE 1                  TO WS-ID-STATUS-ERROR
           END-IF

           IF  WS-SIN-ERROR
               MOVE 1                  TO WS-ID-STATUS-DOC

               IF  WS-COM-DOC(1:8) IS NUMERIC
               AND WS-COM-DOC(9:1) IS ALPHABETIC
               AND WS-COM-DOC(9:1) NOT = SPACES
                   MOVE ZERO           TO WS-ID-STATUS-DOC
               ELSE
                   IF (WS-COM-DOC(1:1) = 'X'
                   OR  WS-COM-DOC(1:1) = 'Y'
                   OR  WS-COM-DOC(1:1) = 'Z')
                   AND WS-COM-DOC(2:7) IS NUMERIC
                   AND WS-COM-DOC(9:1) IS ALPHABETIC
                       MOVE ZERO       TO WS-ID-STATUS-DOC
                   END-IF
               END-IF

               IF  WS-DOC-NOK
                   MOVE MSJ-FMT-DOC-INCORR TO WS-MENSAJE
                   MOVE 1              TO WS-ID-STATUS-ERROR
               END-IF
           END-IF

           IF  WS-SIN-ERROR
           AND WS-PROG-ALTA
               EXEC SQL
                    SELECT ID_CLIENTE
                    INTO   :HV-ID-CLIENTE
                    FROM   BANK.CLIENTE
                    WHERE  DOCID = :WS-COM-DOC
               END-EXEC

               IF  SQLCODE = ZEROS
                   MOVE MSJ-CLI-YA-EXISTE TO WS-MENSAJE
                   MOVE 1              TO WS-ID-STATUS-ERROR
               ELSE
                   IF  SQLCODE NOT = 100
                       MOVE SQLCODE    TO WS-SQLCODE
                       STRING MSJ-ERR-SEL-CLI DELIMITED BY SIZE
                              WS-SQLCODE      DELIMITED BY SIZE
                                       INTO WS-MENSAJE
                       MOVE 1          TO WS-ID-STATUS-ERROR
                   END-IF
               END-IF
           END-IF
           .

      *>---------------------------------------------------------------
       9000-VALIDAR-NOMBRE.
           IF  WS-COM-NOMBRE = SPACES
           OR  WS-COM-NOMBRE = LOW-VALUES
               MOVE MSJ-NOM-OBL        TO WS-MENSAJE
               MOVE 1                  TO WS-ID-STATUS-ERROR
           END-IF
           .

      *>---------------------------------------------------------------
       9000-VALIDAR-EMAIL.
           IF  WS-COM-EMAIL NOT = SPACES
           AND WS-COM-EMAIL NOT = LOW-VALUES
               PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 38
                   IF WS-COM-EMAIL(WS-I:1) = '@'
                      MOVE WS-I        TO WS-POS-ARROBA
                   END-IF

                   IF  WS-COM-EMAIL(WS-I:1) = '.'
                       MOVE WS-I       TO WS-POS-PUNTO
                   END-IF
               END-PERFORM

               IF  WS-POS-ARROBA = ZEROS
               OR  (WS-POS-ARROBA NOT = ZEROS
               AND WS-POS-ARROBA > WS-POS-PUNTO)
                   MOVE MSJ-FMT-EMAIL-INCORR TO WS-MENSAJE
                   MOVE 1              TO WS-ID-STATUS-ERROR
               END-IF
           END-IF
           .

      *>---------------------------------------------------------------
       9000-VALIDAR-TELEFONO.
           IF  WS-COM-TEL NOT = SPACES
           AND WS-COM-TEL NOT = LOW-VALUES
               IF  WS-COM-TEL IS NOT NUMERIC
                   MOVE MSJ-TEL-NO-NUM TO WS-MENSAJE
                   MOVE 1              TO WS-ID-STATUS-ERROR
               END-IF
           END-IF
           .

      *>---------------------------------------------------------------
       9999-VOLVER-MENU-PRINCIPAL.
           IF  EIBCALEN = ZEROS
               EXEC CICS
                    SEND
                    TEXT
                    FROM(WS-MENSAJE)
                    LENGTH(LENGTH OF WS-MENSAJE)
                    ALARM
                    ERASE
                    FREEKB
               END-EXEC

               EXEC CICS
                    RETURN
                    TRANSID('BANK')
               END-EXEC
           ELSE
               EXEC CICS
                    XCTL
                    PROGRAM('BKMENU')
               END-EXEC
           END-IF
           .